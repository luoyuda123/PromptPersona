# 统一换行符：仓库内一律存 LF，检出时按平台自动转换
* text=auto

# 明确声明为文本，避免 CRLF/LF 混杂造成整文件 diff
*.md    text
*.txt   text
*.json  text
*.yml   text
*.yaml  text
*.toml  text
*.ini   text
*.csv   text
*.html  text
*.css   text
*.js    text
*.ts    text
*.py    text

# Windows 脚本需保留 CRLF，否则 cmd 执行可能报错
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell 脚本必须 LF
*.sh    text eol=lf

# 二进制文件不做文本转换与 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
