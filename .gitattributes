# 统一换行符：仓库内一律存 LF，检出时按平台自动转换
* text=auto eol=lf

# 文本文件统一 LF，避免 Windows 检出时出现 “LF will be replaced by CRLF” 警告与整文件 diff
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.py    text eol=lf

# Windows 脚本需保留 CRLF，否则 cmd 执行可能报错
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell 脚本必须 LF
*.sh    text eol=lf

# 二进制文件不做文本转换与 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
